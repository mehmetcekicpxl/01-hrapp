@{
}
@model DuendeIdentityServer.ViewModels.LoginViewModel
@{

}
<!-- Latest compiled and minified CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Latest compiled JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<br />
<h2>Duende Identity Server </h2>
<h3>Login</h3>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="Login" method="post">
			<input type="hidden" asp-for="ReturnUrl" />

			<div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

			<div class="form-group m-3">
				Username
				<input asp-for="Username" type="text" class="form-control" />
			</div>

			<div class="form-group m-3">
				Password
				<input asp-for="Password" type="password" class="form-control" />
			</div>
			<br />
			<div class="form-group m-5">
				<input type="submit" value="Login" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>
<a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-success ms-2">Nieuw Account Registreren</a>