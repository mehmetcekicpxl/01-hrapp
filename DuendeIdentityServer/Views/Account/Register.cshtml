@{
}
@model DuendeIdentityServer.ViewModels.RegisterViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<br />
<h2>Duende Identity Server</h2>
<h3>Registreren</h3>
<hr />

<div class="row">
	<div class="col-md-4">
		<form asp-action="Register" method="post">

			<input asp-for="ReturnUrl" type="hidden" />

			<div class="form-group m-3">
				<label>Username</label>
				<input asp-for="Username" type="text" class="form-control" />
			</div>

			<div class="form-group m-3">
				<label>Email</label>
				<input asp-for="Email" type="email" class="form-control" />
			</div>

			<div class="form-group m-3">
				<label>Password</label>
				<input asp-for="Password" type="password" class="form-control" />
			</div>

			<br />
			<div class="form-group m-3">
				<input type="submit" value="Account Aanmaken" class="btn btn-success" />
				<a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-secondary ms-2">Terug naar Login</a>
			</div>

			<div asp-validation-summary="All" class="text-danger mt-3"></div>
		</form>
	</div>
</div>