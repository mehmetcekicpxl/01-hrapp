@{
}
@model IEnumerable<Product>
@{
	ViewData["Title"] = "Product List";
}

<h1>@ViewData["Title"]</h1>
<a class="btn btn-primary mb-3"  asp-action="Add" asp-controller="Product">Create New Product</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price</td>
            </tr>
        }
    </tbody>
</table>